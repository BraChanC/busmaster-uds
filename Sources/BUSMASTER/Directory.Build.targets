<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- VS 2026 rejects /Gm. A parallel Rebuild then crashes cl.exe or hits C1041
       because several compilers write one PDB. /FS makes that PDB shareable. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <MinimalRebuild>false</MinimalRebuild>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
