    PUSHBUTTON      "&Cancel",IDCANCEL,222,168,50,14
END

IDD_ZLG_ADVANCE DIALOGEX 0, 0, 548, 328
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CAN FD Baud Rate Calculator"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Clock:",IDC_STATIC,8,10,28,8
    COMBOBOX        IDC_ZLG_CLOCK,38,8,48,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "MHz",IDC_STATIC,90,10,16,8
    CONTROL         "CAN FD",IDC_ZLG_FD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,116,9,48,10
    CONTROL         "CAN FD ISO",IDC_ZLG_ISO,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,168,9,62,10
    CONTROL         "Non-ISO",IDC_ZLG_NONISO,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,234,9,46,10
    CONTROL         "CAN FD Accel",IDC_ZLG_EXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,286,9,70,10
    CONTROL         "120 Ohm Term",IDC_ZLG_TERM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,360,9,80,10
    GROUPBOX        "CAN FD Arbitration",IDC_STATIC,6,24,536,128
    LTEXT           "Baud:",IDC_STATIC,14,38,24,8
    COMBOBOX        IDC_ZLG_NOM,40,36,50,90,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Kbps",IDC_STATIC,94,38,18,8
    LTEXT           "Tolerance:",IDC_STATIC,118,38,40,8
    EDITTEXT        IDC_ZLG_NOM_ERR,160,36,36,12,ES_AUTOHSCROLL
    LTEXT           "%",IDC_STATIC,198,38,8,8
    LTEXT           "SJW:",IDC_STATIC,212,38,20,8
    COMBOBOX        IDC_ZLG_SJW,234,36,32,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "+1",IDC_STATIC,270,38,12,8
    CONTROL         "tseg2 >= sjw",IDC_ZLG_TSEG2_SJW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,288,37,70,10
    EDITTEXT        IDC_ZLG_ARB_BRP,64,52,28,11,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_ZLG_ARB_TSEG1,94,52,32,11,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_ZLG_ARB_TSEG2,128,52,32,11,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_ZLG_ARB_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_VSCROLL | WS_TABSTOP,12,64,524,82
    GROUPBOX        "CAN FD Data",IDC_STATIC,6,156,536,108
    LTEXT           "Baud:",IDC_STATIC,14,170,24,8
    COMBOBOX        IDC_ZLG_DATA,40,168,50,90,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Kbps",IDC_STATIC,94,170,18,8
    LTEXT           "Tolerance:",IDC_STATIC,118,170,40,8
    EDITTEXT        IDC_ZLG_DATA_ERR,160,168,36,12,ES_AUTOHSCROLL
    LTEXT           "%",IDC_STATIC,198,170,8,8
    LTEXT           "SJW:",IDC_STATIC,212,170,20,8
    COMBOBOX        IDC_ZLG_DATA_SJW,234,168,32,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "+1",IDC_STATIC,270,170,12,8
    CONTROL         "tseg2 >= sjw",IDC_ZLG_DATA_TSEG2_SJW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,288,169,70,10
    EDITTEXT        IDC_ZLG_DATA_BRP,64,184,28,11,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_ZLG_DATA_TSEG1,94,184,32,11,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_ZLG_DATA_TSEG2,128,184,32,11,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_ZLG_DATA_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_VSCROLL | WS_TABSTOP,12,196,524,62
    LTEXT           "Result:",IDC_STATIC,8,272,28,8
    EDITTEXT        IDC_ZLG_RESULT,40,270,428,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Copy",IDC_ZLG_COPY,474,269,32,14
    LTEXT           "Tip: For CAN FD, keep arbitration BRP <= data BRP. If arbitration baud <= 500 kbps, 87.5% sample point is recommended.",IDC_STATIC,8,288,530,16
    DEFPUSHBUTTON   "OK",IDOK,436,306,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,492,306,50,14
END

IDD_DLG_CHANGE_REGISTERS DIALOGEX 0, 0, 360, 223
STYLE DS_SETFONT | DS_MODALFRAME | DS_CONTEXTHELP | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTEXTHELP
CAPTION "Configure CAN Controller"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         "List1",IDC_LIST_CHANNELS,"SysListView32",LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,6,8,52,178
    EDITTEXT        IDC_EDIT_BAUD_RATE,106,13,40,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_BTR0,106,33,40,14,ES_UPPERCASE | ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_BTR1,106,54,40,14,ES_UPPERCASE | ES_AUTOHSCROLL
    COMBOBOX        IDC_COMB_CLOCK,176,15,29,46,CBS_DROPDOWNLIST | CBS_SORT | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMB_SAMPLING,176,52,36,39,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIT_BRP,251,54,21,13,ES_NOHIDESEL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_WARNING_LIMIT,292,52,21,14,ES_AUTOHSCROLL
    CONTROL         "List1",IDC_LSTC_BTR_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_AUTOARRANGE | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,60,76,282,108
    PUSHBUTTON      "OK",IDC_ButtonOK,237,201,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,292,201,50,14
    GROUPBOX        "",IDC_STAT_BAUD_RATE,60,3,105,70,BS_CENTER
    GROUPBOX        "Options",IDC_STAT_ACCEPTANCE,245,3,97,31
    LTEXT           "Baud Rate:",IDC_STAT_BUAD_RATE,67,13,36,14,SS_CENTERIMAGE
    LTEXT           "BTR0: 0x",IDC_STAT_BTR0,73,33,30,14,SS_CENTERIMAGE
    LTEXT           "BTR1: 0x",IDC_STAT_BTR1,73,54,30,14,SS_CENTERIMAGE
    GROUPBOX        "Clock",IDC_STAT_CLOCK,170,3,70,31,BS_LEFT
    LTEXT           "bps",IDC_STAT_KBPS,148,13,17,14,SS_CENTERIMAGE
    GROUPBOX        "No. of Sample/Bit",IDC_STATIC,170,39,70,34,BS_LEFT
    LTEXT           "MHz",IDC_STATIC,208,19,16,8
    GROUPBOX        "BRP",IDC_STATIC,245,39,35,34
    GROUPBOX        "Warning Limit",IDC_STATIC,285,39,57,34
    PUSHBUTTON      "&Filter",IDC_CBTN_ACCEPTANCE,252,14,39,14
    CONTROL         "________________________________________________________________________________________________",IDC_STAT_LINE3,
                    "Static",SS_LEFTNOWORDWRAP | WS_DISABLED | WS_GROUP,0,185,360,10
    PUSHBUTTON      "&Blink",IDC_CBTN_BLINK,296,14,39,14
    LTEXT           "Description: ",IDC_STATIC,10,203,40,8
    EDITTEXT        IDC_EDIT_CHANNEL_DESC,49,203,178,13,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
END

